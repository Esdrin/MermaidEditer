{
  "name": "mermaideditor",
  "productName": "MermaidEditor",
  "version": "1.3.0",
  "description": "Windows 桌面端 Mermaid 离线编辑器（Visio 风格界面）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win -c.electronDist=node_modules/electron/dist",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win -c.electronDist=node_modules/electron/dist && electron-builder --linux"
  },
  "author": "MermaidEditor <mermaideditor@local>",
  "license": "MIT",
  "dependencies": {
    "mermaid": "10.9.3",
    "naive-ui": "^2.45.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mermaideditor.app",
    "productName": "MermaidEditor",
    "directories": {
      "output": "build-out"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "mmd",
        "name": "Mermaid 图表",
        "description": "Mermaid 图表文件",
        "role": "Editor"
      },
      {
        "ext": "mermaid",
        "name": "Mermaid 图表",
        "description": "Mermaid 图表文件",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Graphics"
    }
  },
  "allowScripts": {
    "electron@44.0.0": true
  }
}
